{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "skill": {
      "*": "ask",
      "apply": "allow",
      "scrape": "allow",
      "upskill": "allow"
    },
    "bash": {
      "*": "ask",
      "bun run *": "allow",
      "bun --version": "allow",
      "python salary_lookup.py *": "allow",
      "python3 salary_lookup.py *": "allow",
      "pdftotext *": "allow",
      "cd cv && lualatex *": "allow",
      "cd ../cover_letters && xelatex *": "allow",
      "lualatex *": "allow",
      "xelatex *": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "question": "allow",
    "task": "allow"
  }
}
